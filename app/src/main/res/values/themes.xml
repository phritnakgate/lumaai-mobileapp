<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LumaAIApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.LumaAIApp" parent="Base.Theme.LumaAIApp" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFD3B6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LumaAIApp</item>
    </style>

    <style name="Theme.PdfView.SelectedTheme" parent="@style/Theme.PdfView.Dark">
        <item name="pdfView_backIcon">@drawable/ic_back_white</item>
        <item name="pdfView_showToolbar">true</item>
        <item name="pdfView_backgroundColor">@color/background_primary</item>
        <item name="pdfView_toolbarColor">@color/primary</item>
        <item name="pdfView_titleTextStyle">@style/LumaAI.TextAppearance.Heading4</item>
        <item name="pdfView_downloadIcon">@drawable/ic_download</item>
        <item name="pdfView_downloadIconTint">@color/white</item>
    </style>

</resources>