<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".presentation.main.chat_history.ChatHistoryActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        >
        <ImageView
            android:id="@+id/imgview_chat_history_back"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/txtview_chat_history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_history_title"
            android:textAppearance="@style/LumaAI.TextAppearance.Heading1.Eng"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgview_chat_history_back"
            />
        <LinearLayout
            android:id="@+id/linearlayout_chat_history_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/txtview_chat_history_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <TextView
                android:id="@+id/txtview_chat_history_task"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_task"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
                android:background="@drawable/rect_primary"
                android:textColor="@color/white"
                />
            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/txtview_chat_history_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_search"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
                android:background="@drawable/rect_bdcolor"
                />
            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/txtview_chat_history_plan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_plan"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
                android:background="@drawable/rect_bdcolor"
                />
            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/txtview_chat_history_genform"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_report"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
                android:background="@drawable/rect_bdcolor"
                />
        </LinearLayout>
        <EditText
            android:id="@+id/edttxt_chat_history_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Thai"
            android:hint="@string/chat_history_search_hint"
            android:drawableTint="@color/disabled"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:background="@drawable/edit_text_bg"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            app:layout_constraintTop_toBottomOf="@+id/linearlayout_chat_history_buttons"
            />
        <ImageView
            android:id="@+id/imgview_chat_history_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_task_date"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearlayout_chat_history_buttons"
            app:tint="@color/disabled"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="12dp"
            android:background="@drawable/edit_text_bg"
            app:layout_constraintTop_toBottomOf="@+id/edttxt_chat_history_search"
            app:layout_constraintBottom_toBottomOf="parent"
            >
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview_chat_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp"
                />
            <ImageView
                android:id="@+id/imgview_chat_history_no_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_no_chat_history"
                app:tint="@color/border_color"
                android:visibility="gone"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtview_chat_history_no_history"
                />
            <TextView
                android:id="@+id/txtview_chat_history_no_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_history_empty"
                android:textColor="@color/border_color"
                android:visibility="gone"
                android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
                app:layout_constraintTop_toBottomOf="@+id/imgview_chat_history_no_history"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>