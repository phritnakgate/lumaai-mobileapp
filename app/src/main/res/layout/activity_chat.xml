<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".presentation.main.chat.ChatActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        >
        <ImageView
            android:id="@+id/imgview_chat_back"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:src="@drawable/ic_back"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txtview_chat_title"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/txtview_chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/chat_title"
            android:paddingHorizontal="12dp"
            android:textAppearance="@style/LumaAI.TextAppearance.Heading1"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintEnd_toStartOf="@+id/imgview_chat_qprompt_btn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imgview_chat_back"
            />
        <ImageView
            android:id="@+id/imgview_chat_qprompt_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_quick_prompt"
            android:layout_marginEnd="20dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/txtview_chat_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imgview_chat_new_btn"
            />
        <ImageView
            android:id="@+id/imgview_chat_new_btn"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:src="@drawable/ic_new_chat"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/imgview_chat_qprompt_btn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <ImageView
            android:id="@+id/imgview_chat_new_mascot"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:src="@drawable/mascot"
            android:visibility="gone"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/txtview_chat_new_desc"
            tools:visibility="visible"
            />
        <TextView
            android:id="@+id/txtview_chat_new_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_empty"
            android:visibility="gone"
            android:textAppearance="@style/LumaAI.TextAppearance.BodyLarge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imgview_chat_new_mascot"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="12dp"
            app:layout_constraintTop_toBottomOf="@+id/txtview_chat_title"
            app:layout_constraintBottom_toTopOf="@+id/constraintlayout_chat_inputarea"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintlayout_chat_inputarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/edit_text_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >
            <ImageButton
                android:id="@+id/imgbtn_chat_send"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_send_chat"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/imgbtn_chat_mic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_voice_chat"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgbtn_chat_send"
                app:layout_constraintTop_toTopOf="parent" />
            <EditText
                android:id="@+id/edttxt_chat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/chat_hint"
                android:background="@android:color/transparent"
                android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imgbtn_chat_mic"
                app:layout_constraintTop_toTopOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>