<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.main.task.view_task.daily_view.ViewTaskDailyFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/txtview_daily_task_events"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_task_events"
            android:textAppearance="@style/LumaAI.TextAppearance.Heading4.Eng"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintlayout_daily_task_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rect_bdcolor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >
            <ImageView
                android:id="@+id/imgview_daily_task_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_task_add"
                android:paddingStart="10dp"
                android:paddingEnd="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/txtview_daily_task_add"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id="@+id/txtview_daily_task_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_task_add"
                android:paddingHorizontal="10dp"
                android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
                app:layout_constraintStart_toEndOf="@id/imgview_daily_task_add"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_daily_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/constraintlayout_daily_task_add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <ImageView
            android:id="@+id/imgview_daily_task_no_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_task"
            android:visibility="gone"
            app:layout_constraintVertical_chainStyle="packed"
            app:tint="@color/border_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtview_daily_task_no_task"
            app:layout_constraintTop_toTopOf="parent"
             />
        <TextView
            android:id="@+id/txtview_daily_task_no_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_task_no_task_today"
            android:textColor="@color/border_color"
            android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/imgview_daily_task_no_task"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>