<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <include
        android:id="@+id/task_layout_container_monthly_head"
        layout="@layout/recycler_task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"

        app:layout_constraintHorizontal_weight="8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/constraintlayout_monthly_recycler_head_date"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintlayout_monthly_recycler_head_date"
        android:layout_width="0dp"
        app:layout_constraintHorizontal_weight="1"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/task_layout_container_monthly_head"
        app:layout_constraintBottom_toBottomOf="@+id/task_layout_container_monthly_head"

        >
        <TextView
            android:id="@+id/txtview_monthly_recycler_head_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="12"
            android:gravity="center"

            android:textAppearance="@style/LumaAI.TextAppearance.Heading3.Eng"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/txtview_monthly_recycler_head_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sat"
            android:gravity="center"
            android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtview_monthly_recycler_head_date" />
        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:background="@color/border_color"
            app:layout_constraintTop_toBottomOf="@+id/txtview_monthly_recycler_head_day"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>