<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">
    
    <TextView
        android:id="@+id/txtview_label_text_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/LumaAI.TextAppearance.BodyLarge.Eng"
        tools:text="Label*" />

    <EditText
        android:id="@+id/edttxt_label_text_area"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/edit_text_bg"
        android:duplicateParentState="true"
        android:gravity="top"
        android:inputType="text|textMultiLine"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="50dp"
        android:paddingBottom="16dp"
        android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Eng"
        app:layout_constraintTop_toBottomOf="@id/txtview_label_text_area"
        tools:hint="Hint" />

</merge>