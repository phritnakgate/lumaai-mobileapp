<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    tools:context=".presentation.main.chat.voice_chat.VoiceChatActivity">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView_voice_chat"
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:lottie_rawRes="@raw/voice_chat_animation"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/txtview_voice_chat_title"
        />

    <TextView
        android:id="@+id/txtview_voice_chat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_empty"
        android:textColor="@color/white"
        android:textAppearance="@style/LumaAI.TextAppearance.BodyLarge"
        android:paddingVertical="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/animationView_voice_chat"
        app:layout_constraintBottom_toTopOf="@+id/imgbtn_voice_chat_cancel"
        />
    <ImageButton
        android:id="@+id/imgbtn_voice_chat_cancel"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:background="@drawable/circ_danger"
        android:src="@drawable/ic_cancel_voice"
        app:tint="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/txtview_voice_chat_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>