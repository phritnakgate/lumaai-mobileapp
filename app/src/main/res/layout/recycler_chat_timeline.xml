<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp">
    <TextView
        android:id="@+id/txtview_viewholder_chat_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Thai"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Example Text"
        tools:textColor="@color/black"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintlayout_viewholder_chat_history_readall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_bdcolor"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_marginTop="7dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtview_viewholder_chat_history"
        tools:visibility="visible"
        >
        <ImageView
            android:id="@+id/imgview_viewholder_chat_history_readall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_read_all"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txtview_viewholder_chat_history_readall"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/txtview_viewholder_chat_history_readall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_history_readall"
            android:paddingHorizontal="8dp"
            android:textAppearance="@style/LumaAI.TextAppearance.BodySmall.Eng"
            app:layout_constraintStart_toEndOf="@id/imgview_viewholder_chat_history_readall"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>