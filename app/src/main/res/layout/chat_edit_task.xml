<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintlayout_chat_edit_task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="2"
        android:padding="12dp"
        android:gravity="start"
        android:background="@drawable/rect_primary"
        app:layout_constraintEnd_toStartOf="@+id/space_chat_edit_task"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
        <TextView
            android:id="@+id/txtview_chat_edit_task_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textAppearance="@style/LumaAI.TextAppearance.Heading4"
            tools:text="ประชุมอัพเดตงาน"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/txtview_chat_edit_task_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium"
            tools:text="ประชุมอัพเดตงาน"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtview_chat_edit_task_name"
            />
        <ImageView
            android:id="@+id/imgview_chat_edit_task_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_task_time"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtview_chat_edit_task_desc"
            />
        <TextView
            android:id="@+id/txtview_chat_edit_task_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium"
            tools:text="4 Sep 2025 | 18:00"
            android:paddingHorizontal="6dp"
            app:layout_constraintStart_toEndOf="@+id/imgview_chat_edit_task_date"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtview_chat_edit_task_desc"
            />
        <TextView
            android:id="@+id/txtview_chat_edit_task_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:gravity="center"
            android:background="@drawable/rect_danger_btn"
            android:textAppearance="@style/LumaAI.TextAppearance.Heading4"
            android:textColor="@color/white"
            android:text="@string/chat_confirm_edit"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/txtview_chat_edit_task_date"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Space
        android:id="@+id/space_chat_edit_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/constraintlayout_chat_edit_task"
        />
</androidx.constraintlayout.widget.ConstraintLayout>