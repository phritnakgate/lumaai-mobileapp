<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="20dp">
    <TextView
        android:id="@+id/txtview_bottomsheet_readall_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/read_all_bottomsheet_title"
        android:textAppearance="@style/LumaAI.TextAppearance.Heading4.Eng"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <ImageView
        android:id="@+id/imgview_bottomsheet_readall_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bottomsheet_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <ScrollView
        android:id="@+id/scrollview_bottomsheet_readall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/txtview_bottomsheet_readall_title"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <TextView
            android:id="@+id/txtview_bottomsheet_readall_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/LumaAI.TextAppearance.BodyMedium.Thai"
            tools:text="@tools:sample/lorem/random"
            />

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>