<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumaAIApp"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".presentation.main.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.main.chat.voice_chat.VoiceChatActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.main.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".presentation.main.chat_history.ChatHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.main.task.edit_task.EditTaskActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.main.task.add_task.AddTaskActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.main.task.view_task.ViewTaskActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.auth.register.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.main.home.HomeActivity"
            android:exported="false"/>
        <activity
            android:name=".presentation.auth.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.auth.LandingActivity"
            android:exported="false"/>
        <activity
            android:name=".MyApplication"
            android:exported="false" />
    </application>

</manifest>